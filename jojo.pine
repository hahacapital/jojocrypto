//@version=6
indicator("jojo", overlay=false, max_bars_back=50)

// ---- Inputs ----
maLen   = input.int(3, "jojo SMA length", minval=1)
lowTh   = input.float(25, "Buy threshold (below)")
highTh  = input.float(85, "Sell threshold (above)")
obLevel = input.float(80, "Overbought level")
obExit  = input.float(70, "Overbought recovery level")
osLevel = input.float(20, "Oversold level")
osExit  = input.float(20, "Oversold recovery level")

// ---- A. Components inferred from controlled probes; exact recovery is unproven ----
// ROC(10), centered at 50 and clipped to 0..100.
c_roc = math.max(0.0, math.min(100.0, 50.0 + ta.roc(close, 10)))

// MFI(14), with a neutral fallback of 50 when flow totals are unavailable.
tpChg = ta.change(hlc3)
upF   = math.sum(tpChg > 0 ? volume * hlc3 : 0.0, 14)
dnF   = math.sum(tpChg < 0 ? volume * hlc3 : 0.0, 14)
c_mfi = upF + dnF > 0 ? 100.0 * upF / (upF + dnF) : 50.0

// CMF(21): clip 50 + 150 * CMF to 0..100; use 50 without a positive volume sum.
// Evaluate rolling sums on every bar, outside conditional branches, to preserve warmup.
mfv    = high == low ? 0.0 : ((close - low) - (high - close)) / (high - low) * volume
mfvSum = math.sum(mfv, 21)
volSum = math.sum(volume, 21)
c_cmf  = volSum > 0 ? math.max(0.0, math.min(100.0, 50.0 + 150.0 * mfvSum / volSum)) : 50.0

// ---- B. Eleven fitted price oscillators ----
// PSY(14): percentage of bars with a positive close change.
c_psy = math.sum(nz(ta.change(close)) > 0 ? 1.0 : 0.0, 14) / 14.0 * 100.0

// Aroon(14): separately weighted up and inverted down components.
c_aroonUp = 100.0 * (ta.highestbars(high, 15) + 14) / 14.0
c_aroonDn = 100.0 - 100.0 * (ta.lowestbars(low, 15) + 14) / 14.0

// Stoch RSI(7, 14)
r7     = ta.rsi(close, 7)
c_srsi = ta.stoch(r7, r7, r7, 14)

// Bollinger z-score(22), centered at 50.
c_bb = math.max(0.0, math.min(100.0, 50.0 + 16.8176 * (hlc3 - ta.sma(hlc3, 22)) / ta.stdev(hlc3, 22)))

// %K(17)
c_k17 = math.max(0.0, math.min(100.0, 50.0 + 0.9925 * (ta.stoch(close, high, low, 17) - 50.0)))

// Regression slope over 12 bars, divided by population standard deviation.
f_slopeZ(float src, int n) =>
    float xm  = (n - 1) / 2.0
    float ym  = ta.sma(src, n)
    float num = 0.0
    float den = 0.0
    for i = 0 to n - 1
        float x = (n - 1 - i) - xm
        num += x * (src[i] - ym)
        den += x * x
    num / den / ta.stdev(src, n)
c_slope = math.max(0.0, math.min(100.0, 50.0 + 82.02 * f_slopeZ(close, 12)))

// TSI(10, 9)
c_tsi = math.max(0.0, math.min(100.0, 50.0 + 73.96 * ta.tsi(close, 10, 9)))

// Fisher transform(14).
fHi  = ta.highest(hl2, 14)
fLo  = ta.lowest(hl2, 14)
fVal = 0.0
fVal := math.max(-0.999, math.min(0.999, 0.66 * ((hl2 - fLo) / math.max(fHi - fLo, 1e-12) - 0.5) + 0.67 * nz(fVal[1])))
fish = 0.0
fish := 0.5 * math.log((1 + fVal) / (1 - fVal)) + 0.5 * nz(fish[1])
c_fish = math.max(0.0, math.min(100.0, 50.0 + 23.10 * fish))

// RCI(9): rank correlation; newer bars rank first on price ties.
f_rci(float src, int n) =>
    float d2 = 0.0
    for i = 0 to n - 1
        int rank = 1
        for j = 0 to n - 1
            if src[j] > src[i] or (src[j] == src[i] and j < i)
                rank += 1
        d2 += math.pow(i + 1 - rank, 2)
    (1.0 - 6.0 * d2 / (n * (n * n - 1))) * 100.0
c_rci = 50.0 + f_rci(close, 9) / 2.0

// RMI(2, 4): RSI-style smoothing of four-bar momentum.
rmiMom = close - close[4]
rmiUp  = ta.rma(math.max(rmiMom, 0), 2)
rmiDn  = ta.rma(math.max(-rmiMom, 0), 2)
c_rmi  = 100.0 * rmiUp / (rmiUp + rmiDn)

// ---- C. Weighted sum (rounded weights sum to 0.999998); no final smoothing ----
partA = 0.043770 * c_roc + 0.047316 * c_mfi + 0.048732 * c_cmf
partB = 0.05025 * c_psy + 0.06742 * c_aroonUp + 0.06397 * c_aroonDn + 0.04256 * c_srsi + 0.10131 * c_bb + 0.06222 * c_k17
partC = 0.06667 * c_slope + 0.19263 * c_tsi + 0.11529 * c_fish + 0.05961 * c_rci + 0.03825 * c_rmi
jojo  = math.max(0.0, math.min(100.0, partA + partB + partC))

// ---- High-contrast rainbow: blue, cyan, green, yellow, orange, red ----
f_rainbow(float v) =>
    float x = math.max(0.0, math.min(100.0, v))
    color c = na
    if x < 18
        c := color.from_gradient(x, 0, 18, #2962FF, #00B0FF)
    else if x < 30
        c := color.from_gradient(x, 18, 30, #00B0FF, #00E5FF)
    else if x < 42
        c := color.from_gradient(x, 30, 42, #00E5FF, #00E676)
    else if x < 55
        c := color.from_gradient(x, 42, 55, #00E676, #C6FF00)
    else if x < 65
        c := color.from_gradient(x, 55, 65, #C6FF00, #FFEA00)
    else if x < 75
        c := color.from_gradient(x, 65, 75, #FFEA00, #FF9100)
    else if x < 87
        c := color.from_gradient(x, 75, 87, #FF9100, #FF3D00)
    else
        c := color.from_gradient(x, 87, 100, #FF3D00, #FF1744)
    c

// ---- Persistent overbought / oversold states ----
// Codes: +2 overbought, +1 recovered from overbought, -1 recovered from oversold, -2 oversold, 0 unset.
// Sign records the side; absolute value distinguishes the latched extreme state from recovery.
// Recovery requires a strict cross beyond the corresponding exit threshold.
// Recovery states persist until another overbought or oversold entry.
var int state = 0
if not na(jojo)
    if jojo >= obLevel
        state := 2
    else if jojo <= osLevel
        state := -2
    else if state == 2 and jojo < obExit
        state := 1
    else if state == -2 and jojo > osExit
        state := -1
// Count starts at 1 on the first bar and resets to 1 on each state transition.
var int barsInState = 0
if bar_index == 0 or state != state[1]
    barsInState := 1
else
    barsInState += 1
stateText  = state == 2 ? "Overbought" : state == 1 ? "Recovered from overbought" : state == -2 ? "Oversold" : state == -1 ? "Recovered from oversold" : "Unset"
stateColor = state == 2 ? #FF1744 : state == 1 ? #FF9100 : state == -2 ? #2962FF : state == -1 ? #00E5FF : color.gray
stateTxtCol = state == 1 or state == -1 ? color.black : color.white

// ---- SMA-cross markers with a threshold on the previous jojo value ----
jojoMa     = ta.sma(jojo, maLen)
buySignal  = ta.crossover(jojo, jojoMa)  and jojo[1] < lowTh
sellSignal = ta.crossunder(jojo, jojoMa) and jojo[1] > highTh

// ---- First three plots: jojo, state code, and state duration for screening ----
plot(jojo, "jojo", color=f_rainbow(jojo), linewidth=2)
plot(state, "jojo state code", display=display.data_window)
plot(barsInState, "Bars in state", display=display.data_window)
plotshape(buySignal,  "Buy", shape.triangleup,   location.bottom, color.green)
plotshape(sellSignal, "Sell", shape.triangledown, location.top,    color.red)

hline(obLevel, "Overbought level",       color=#FF1744,    linestyle=hline.style_dashed)
hline(obExit,  "Overbought recovery level", color=#FF9100,    linestyle=hline.style_dashed)
hline(50,      "Midline",         color=color.gray, linestyle=hline.style_dotted)
hline(osLevel, "Oversold level",       color=#2962FF,    linestyle=hline.style_dashed)

// Current reading, state, and duration; dark text on bright backgrounds.
var table info = table.new(position.top_right, 2, 1, border_width=1)
if barstate.islast
    valTxtCol = jojo >= 18 and jojo < 87 ? color.black : color.white
    table.cell(info, 0, 0, "jojo " + str.tostring(jojo, "#.0"), text_color=valTxtCol, bgcolor=f_rainbow(jojo), text_size=size.small)
    table.cell(info, 1, 0, stateText + " | " + str.tostring(barsInState) + " bars", text_color=stateTxtCol, bgcolor=stateColor, text_size=size.small)

// Alerts fire when entering a new state.
alertcondition(state == 2 and state[1] != 2,   "jojo overbought",       "jojo entered overbought")
alertcondition(state == 1 and state[1] != 1,   "jojo recovered from overbought", "jojo recovered from overbought")
alertcondition(state == -2 and state[1] != -2, "jojo oversold",       "jojo entered oversold")
alertcondition(state == -1 and state[1] != -1, "jojo recovered from oversold", "jojo recovered from oversold")
